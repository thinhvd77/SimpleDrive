BASE_URL=http://localhost:5173
DOMAIN=drive.example.com
POSTGRES_USER=simpledrive
POSTGRES_DB=simpledrive
POSTGRES_PASSWORD=change-this-password
PORT=4000
HOST=127.0.0.1
DATABASE_URL=postgresql://simpledrive:change-this-password@localhost:5432/simpledrive
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DATA_DIR=./data/files
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
MAX_FILE_BYTES=2000000000
USER_QUOTA_BYTES=20000000000
GLOBAL_QUOTA_BYTES=100000000000
MIN_FREE_BYTES=20000000000
RETENTION_HOURS=72
UPLOAD_IDLE_HOURS=24
IMPORT_CONCURRENCY=2
# Optional, server-side restricted API key for PUBLIC Google Drive files only.
# Enable Google Drive API; restrict the key to Drive API and the server public IP.
# GOOGLE_DRIVE_API_KEY=
